{
    "version": 2,
    "builds": [
        {
            "src": "index.html",
            "use": "@vercel/static"
        },
        {
            "src": "pages/**",
            "use": "@vercel/static"
        },
        {
            "src": "css/**",
            "use": "@vercel/static"
        },
        {
            "src": "images/**",
            "use": "@vercel/static"
        },
        {
            "src": "components/**",
            "use": "@vercel/static"
        },
        {
            "src": "api/server.js",
            "use": "@vercel/node"
        },
        {
            "src": "pages/subpages/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "api/server.js"
        },
        {
            "src": "/",
            "dest": "/index.html"
        },
        {
            "src": "/aboutus",
            "dest": "/pages/aboutus.html"
        },
        {
            "src": "/contact",
            "dest": "/pages/contact.html"
        },
        {
            "src": "/ranking",
            "dest": "/pages/ranking.html"
        },
        {
            "src": "/students",
            "dest": "/pages/students.html"
        },
        {
            "src": "/class1",
            "dest": "/pages/subpages/class1.html"
        }
    ]
}